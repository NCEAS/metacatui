# Ignore everything in src/components/semantic except the distribution files we
# need and the src files we've modified from the npm source.
src/components/semantic/*
!src/components/semantic/semantic.json
!src/components/semantic/README.md

!src/components/semantic/dist/
src/components/semantic/dist/*
!src/components/semantic/dist/semantic.min.css
!src/components/semantic/dist/semantic.min.js

!src/components/semantic/src/
